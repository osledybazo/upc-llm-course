# Copy to .env and edit. .env is git-ignored — never commit your key.
# This is the model your ASSISTANT talks to (not the one that writes your code).

# Default: Ollama on the host machine, small local model, no key, no cost.
#   ollama serve && ollama pull qwen3:1.7b
# From inside Docker the host is host.docker.internal (NOT localhost — that's the container itself).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:1.7b

# Switch to a frontier model by changing ONLY these three lines — no code changes:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini

# Optional
LLM_TEMPERATURE=0.2
# MAX_DOC_BYTES=1000000
