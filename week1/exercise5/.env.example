# Copy to .env and edit. .env is git-ignored — never commit your key.

# Any OpenAI-compatible endpoint. Default: Ollama running on the host machine.
# From inside Docker, the host is host.docker.internal (NOT localhost — that's the container itself).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
# A vision-capable model lets you attach images (ministral-3, gemma4, qwen2.5vl, gpt-4.1-mini...).
LLM_MODEL=ministral-3:14b

# Cloud examples (swap the three lines above):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
#
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen3-235b-a22b

# Optional
SYSTEM_PROMPT=You are a helpful assistant. Answer in Markdown.
LLM_TEMPERATURE=0.7
